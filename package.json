{
  "name": "farajasoft",
  "version": "0.1.0",
  "private": true,
  "description": "FarajaSoft platform: one login, one database and one ledger connection, with each business system (water, HR, procurement…) as a module",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:finance": "vitest run --project finance",
    "db:seed": "tsx --env-file=.env.local src/scripts/seed.ts",
    "module:new": "tsx src/scripts/new-module.ts",
    "import:farajasofterp": "tsx --env-file=.env.local src/scripts/import-farajasofterp.ts",
    "db:backup": "tsx --env-file=.env.local src/scripts/backup.ts backup",
    "db:restore": "tsx --env-file=.env.local src/scripts/backup.ts restore"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@node-saml/node-saml": "^5.1.0",
    "@tanstack/react-query": "^5.83.0",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.2",
    "decimal.js": "^10.6.0",
    "jose": "^6.0.11",
    "leaflet": "^1.9.4",
    "mongoose": "^8.18.0",
    "next": "^16.3.8",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.30.0",
    "eslint-config-next": "^16.3.8",
    "mongodb-memory-server": "^10.4.3",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^5.0.3",
    "xml-crypto": "^6.3.3"
  },
  "engines": {
    "node": ">=20.6"
  }
}
