# Copy to .env.local for development. On Vercel, set these in Project Settings → Environment Variables.

# MongoDB must support transactions (a replica set, e.g. MongoDB Atlas). Every module shares this one database;
# it can sit on the same cluster as FarajaSoft Accounting.
MONGODB_URI=mongodb://127.0.0.1:27018/farajasoft?directConnection=true

# At least 32 random characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more

# Optional: key for secrets stored in settings (accounting API key, SMS key). Defaults to JWT_SECRET; keep it stable.
# SETTINGS_ENCRYPTION_KEY=

# Session cookies are Secure in production; set to false only for plain-HTTP testing.
# COOKIE_SECURE=false

# Indexes are synced when a server instance starts; set to false to skip that on cold starts.
# DB_SETUP_ON_START=false

# Used by `npm run db:seed` to create the organisation and its first administrator.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
# Password for every demo user made by `npm run db:seed -- --demo` (testers); defaults to the admin's.
# SEED_DEMO_PASSWORD=Demo-Test-2026
# SEED_ORG_NAME=Tachasis Water and Sanitation Company
# SEED_ORG_CODE=TACHWASCO
# Modules to switch on and seed (comma-separated); defaults to every installed module.
# SEED_MODULES=water

# Importing a company from farajasofterp (npm run import:farajasofterp)
SOURCE_MONGODB_URI=
SOURCE_COMPANY_ID=
SOURCE_FIELD_ENCRYPTION_KEY=
IMPORT_ORG_CODE=
